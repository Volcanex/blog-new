        saveBtn.addEventListener('click', e => {
            e.stopPropagation();
            const statusEl = editor.querySelector('.meta-status');
            saveMetadata(
                photo, card,
                editor.querySelector('.meta-desc').value,
                editor.querySelector('.meta-loc').value,
                editor.querySelector('.meta-city').value,
                editor.querySelector('.meta-country').value,
