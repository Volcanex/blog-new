        const rotCW = document.createElement('button');
        rotCW.className = 'adm-btn rotate-btn';
        rotCW.textContent = '↻';
        rotCW.title = 'Rotate CW';
        rotCW.addEventListener('click', e => { e.stopPropagation(); rotatePhoto(photo, card, 'cw'); });

        rotRow.appendChild(rotCCW);
        rotRow.appendChild(rotCW);

        const editBtn = document.createElement('button');
        editBtn.className = 'adm-btn edit-meta-btn';
        editBtn.textContent = 'edit info';
