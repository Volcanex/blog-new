<script>
(function () {
    'use strict';

    const PAGE_SIZE = 24;
    const GAP = 10;
    const MIN_COL_WIDTH = 360;

    let allPhotos = [];        // raw photos from API (full set)
    let viewPhotos = [];       // current filtered slice rendered in the gallery
    let currentFilter = 'highlights'; // 'highlights' | 'all' | {type:'monthplace', monthYear, city}
    let shown = 0;
    let currentIdx = -1;        // index into viewPhotos
    let selectMode = false;
    const selectedFiles = new Set();
    let viewMode = 'masters'; // 'masters' or 'raw'

    // ── iOS Detection ────────────────────────────────────
    function isIOS() {
        return /iPhone|iPad|iPod/i.test(navigator.userAgent) ||
               (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    }

    // ── Admin state ──────────────────────────────────────
    const STORAGE_KEY = 'photo_admin_pw';

    function getAdminPassword() { return sessionStorage.getItem(STORAGE_KEY) || ''; }
    function isAdmin() { return !!getAdminPassword(); }
    function setAdminPassword(pw) {
        pw ? sessionStorage.setItem(STORAGE_KEY, pw) : sessionStorage.removeItem(STORAGE_KEY);
    }
    function adminHeaders() {
        const pw = getAdminPassword();
        return pw ? { 'X-Admin-Password': pw } : {};
    }

    // ── View mode (masters/raw) toggle ───────────────────
    function setViewMode(mode) {
        viewMode = mode;
        const mastersBtn = document.getElementById('view-masters');
        const rawBtn = document.getElementById('view-raw');

        if (mode === 'masters') {
            mastersBtn.classList.add('active');
            rawBtn.classList.remove('active');
        } else {
            rawBtn.classList.add('active');
            mastersBtn.classList.remove('active');
        }

        loadPhotos();
    }

    // ── Settings + Auth modal ────────────────────────────
    const settingsBtn   = document.getElementById('settings-btn');
    const authOverlay   = document.getElementById('auth-overlay');
    const authStatus    = document.getElementById('auth-status');
    const authPassword  = document.getElementById('auth-password');
    const authSubmit    = document.getElementById('auth-submit');
    const authCancel    = document.getElementById('auth-cancel');
    const authLogout    = document.getElementById('auth-logout');
    const authLoginForm = document.getElementById('auth-login-form');
    const authLoggedIn  = document.getElementById('auth-logged-in');
    const authTitle     = document.getElementById('auth-title');

    function openModal() {
        if (isAdmin()) {
            authLoginForm.style.display = 'none';
            authLoggedIn.style.display  = 'block';
            authTitle.textContent = 'Admin mode active';
            authStatus.textContent = '';
            authStatus.className = 'auth-status';
        } else {
            authLoginForm.style.display = 'block';
            authLoggedIn.style.display  = 'none';
            authTitle.textContent = 'Admin access';
            authStatus.textContent = '';
            authStatus.className = 'auth-status';
            authPassword.value = '';
            setTimeout(() => authPassword.focus(), 80);
        }
        authOverlay.classList.add('open');
    }
    function closeModal() { authOverlay.classList.remove('open'); }

    settingsBtn.addEventListener('click', openModal);
    authCancel.addEventListener('click', closeModal);
    authOverlay.addEventListener('click', e => { if (e.target === authOverlay) closeModal(); });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && authOverlay.classList.contains('open')) closeModal();
    });

    function submitLogin() {
        const pw = authPassword.value.trim();
        if (!pw) return;
        authStatus.textContent = '...';
        authStatus.className = 'auth-status';
        authSubmit.disabled = true;
        fetch('/api/photography/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: pw })
        })
            .then(r => r.json())
            .then(data => {
                authSubmit.disabled = false;
                if (data.ok) {
                    setAdminPassword(pw);
                    applyAdminMode();
                    authStatus.textContent = 'authenticated';
                    authStatus.className = 'auth-status ok';
                    setTimeout(closeModal, 800);
                } else {
                    authStatus.textContent = 'incorrect password';
                    authStatus.className = 'auth-status err';
                    authPassword.value = '';
                    authPassword.focus();
                }
            })
            .catch(() => {
                authSubmit.disabled = false;
                authStatus.textContent = 'error — try again';
                authStatus.className = 'auth-status err';
            });
    }

    authSubmit.addEventListener('click', submitLogin);
    authPassword.addEventListener('keydown', e => { if (e.key === 'Enter') submitLogin(); });
    authLogout.addEventListener('click', () => {
        setAdminPassword('');
        removeAdminMode();
        closeModal();
    });

    // ── View mode toggle listeners ───────────────────────
    document.getElementById('view-masters').addEventListener('click', () => setViewMode('masters'));
    document.getElementById('view-raw').addEventListener('click', () => setViewMode('raw'));

    function applyAdminMode() {
        document.body.classList.add('admin-mode');
        settingsBtn.classList.add('admin-active');
        loadPhotos();
    }
    function removeAdminMode() {
        document.body.classList.remove('admin-mode');
        settingsBtn.classList.remove('admin-active');
        loadPhotos();
    }

    // ── Helpers ──────────────────────────────────────────
    const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    function fmtDate(iso) {
        if (!iso) return '';
        const p = iso.split('-');
        if (p.length < 2) return iso;
        return `${MONTHS[parseInt(p[1],10)-1]} ${p[0]}`;
    }

    function exifLine(p) {
        return [p.aperture, p.shutter, p.iso, p.focal_length].filter(Boolean).join('  ·  ');
    }

    function thumbUrl(filename, size, rotation) {
        const path = viewMode === 'raw' ? '/api/photography/raw/thumbnail/' : '/api/photography/thumbnail/';
        let u = path + encodeURIComponent(filename) + '?size=' + size;
        if (rotation) u += '&r=' + rotation;
        return u;
    }

    // Reserve the LQIP wrapper's aspect-ratio so the masonry doesn't jump and
    // the blurred placeholder has a box to render in. When manifest dimensions
    // are present we use the exact ratio; otherwise we fall back to 3/2 (the
    // D610's native landscape) which still gives the wrap a real height. On
    // image load we override with naturalWidth/Height so portraits and squares
    // resolve to their true ratio.
    function applyImgWrapDims(wrap, photo) {
        let w, h;
        if (photo.width && photo.height) {
            const swap = photo.rotation === 90 || photo.rotation === 270;
            w = swap ? photo.height : photo.width;
            h = swap ? photo.width  : photo.height;
        } else {
            w = 3; h = 2;
        }
        wrap.style.aspectRatio = w + ' / ' + h;
    }

    function fullPhotoUrl(filename, rotation) {
        const path = viewMode === 'raw' ? '/api/photography/raw/full/' : '/api/photography/full/';
        return path + encodeURIComponent(filename) + (rotation ? '?r=' + rotation : '');
    }

    function placeLine(p) {
        const parts = [];
        if (p.location) parts.push(p.location);
        if (p.city)    parts.push(p.city);
        if (p.country) parts.push(p.country);
        return parts.join(', ');
    }

    // ── Admin actions ────────────────────────────────────

    function toggleHide(photo, card) {
        const base = viewMode === 'raw' ? '/api/photography/raw' : '/api/photography';
        const endpoint = photo.hidden ? `${base}/unhide` : `${base}/hide`;
        fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...adminHeaders() },
            body: JSON.stringify({ filename: photo.filename })
        })
            .then(r => { if (r.status === 401) { setAdminPassword(''); removeAdminMode(); return null; } return r.json(); })
            .then(data => {
                if (!data) return;
                photo.hidden = !photo.hidden;
                updateCardHiddenState(card, photo);
            })
            .catch(() => {});
    }

    function toggleBackground(photo, card) {
        fetch('/api/photography/toggle-background', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...adminHeaders() },
            body: JSON.stringify({ filename: photo.filename })
        })
            .then(r => { if (r.status === 401) { setAdminPassword(''); removeAdminMode(); return null; } return r.json(); })
            .then(data => {
                if (!data) return;
                photo.isBackground = data.isBackground;
                if (card) updateCardBackgroundState(card, photo);
                // Keep the lightbox star in sync if this is the photo currently open.
                if (currentIdx !== -1 && viewPhotos[currentIdx] === photo) updateLightboxStar(photo);
                // Sidebar count + (if viewing highlights) gallery membership both depend on this flag
                if (typeof buildSidebar === 'function') buildSidebar();
                if (filterIsHighlights()) applyFilter('highlights');
            })
            .catch(() => {});
    }

    function updateLightboxStar(photo) {
        const btn = document.getElementById('lb-star');
        if (!btn) return;
        const on = !!(photo && photo.isBackground);
        btn.textContent = on ? '★ highlighted' : '☆ highlight';
        btn.classList.toggle('is-on', on);
    }

    function updateCardBackgroundState(card, photo) {
        const star = card.querySelector('.highlight-star');
        if (star) {
            star.textContent = photo.isBackground ? '★' : '☆';
            star.title = photo.isBackground ? 'Remove from highlights' : 'Add to highlights';
            star.classList.toggle('is-on', !!photo.isBackground);
        }
    }

    function updateCardHiddenState(card, photo) {
        const btn = card.querySelector('.toggle-hide-btn');
        if (photo.hidden) {
            card.classList.add('is-hidden');
            if (btn) btn.textContent = 'unhide';
        } else {
            card.classList.remove('is-hidden');
            if (btn) btn.textContent = 'hide';
        }
    }

    function rotatePhoto(photo, card, direction) {
        const endpoint = viewMode === 'raw' ? '/api/photography/raw/rotate' : '/api/photography/rotate';
        fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...adminHeaders() },
            body: JSON.stringify({ filename: photo.filename, direction })
        })
            .then(r => { if (r.status === 401) { setAdminPassword(''); removeAdminMode(); return null; } return r.json(); })
            .then(data => {
                if (!data || !data.ok) return;
                photo.rotation = data.rotation;
                // Reload the card image with new rotation, and refresh the LQIP
                // background + aspect-ratio so the wrapper stays correct.
                const img  = card.querySelector('.card-img');
                const wrap = card.querySelector('.card-img-wrap');
                if (wrap) {
                    wrap.classList.remove('loaded');
                    applyImgWrapDims(wrap, photo);
                    wrap.style.setProperty('--lqip', `url("${thumbUrl(photo.filename, 32, photo.rotation)}")`);
                }
                if (img) {
                    img.classList.remove('loaded');
                    img.src = thumbUrl(photo.filename, 800, photo.rotation);
                    img.addEventListener('load', () => {
                        img.classList.add('loaded');
                        if (wrap) wrap.classList.add('loaded');
                        layoutMasonry();
                    }, { once: true });
                }
            })
            .catch(() => {});
    }

    function saveMetadata(photo, card, desc, loc, city, country, statusEl) {
        statusEl.textContent = '...';
        const endpoint = viewMode === 'raw' ? '/api/photography/raw/update-metadata' : '/api/photography/update-metadata';
        fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...adminHeaders() },
            body: JSON.stringify({ filename: photo.filename, description: desc, location: loc, city: city, country: country })
        })
            .then(r => { if (r.status === 401) { setAdminPassword(''); removeAdminMode(); return null; } return r.json(); })
            .then(data => {
                if (!data) return;
                photo.description    = desc;
                photo.location       = loc;
                photo.city           = city;
                photo.city_assumed   = false;
                photo.country        = country;
                photo.country_assumed = false;
                // Update the visible place line on the card
                const placeEl = card.querySelector('.card-place');
                if (placeEl) {
                    const pl = placeLine(photo);
                    placeEl.textContent = pl;
                    placeEl.style.display = pl ? '' : 'none';
                }
                statusEl.textContent = 'saved';
                setTimeout(() => { statusEl.textContent = ''; }, 1500);
            })
            .catch(() => { statusEl.textContent = 'error'; });
    }

    // ── Select mode ───────────────────────────────────────

    function updateSelectBar() {
        const n = selectedFiles.size;
        const bar = document.getElementById('select-bar');
        document.getElementById('select-count').textContent = n + ' selected';
        bar.classList.toggle('visible', n > 0);
    }

    function clearSelection() {
        selectedFiles.clear();
        document.querySelectorAll('.photo-card.selected').forEach(c => c.classList.remove('selected'));
        updateSelectBar();
    }

    function toggleSelectMode() {
        selectMode = !selectMode;
        document.getElementById('select-btn').classList.toggle('select-active', selectMode);
        document.body.classList.toggle('select-mode', selectMode);
        if (!selectMode) { clearSelection(); }
    }

    function toggleCardSelect(photo, card) {
        if (selectedFiles.has(photo.filename)) {
            selectedFiles.delete(photo.filename);
            card.classList.remove('selected');
        } else {
            selectedFiles.add(photo.filename);
            card.classList.add('selected');
        }
        updateSelectBar();
    }

    async function downloadFile(filename, rotation) {
        const url = fullPhotoUrl(filename, rotation);

        // On iOS, use native share instead of download
        if (isIOS() && navigator.share) {
            try {
                const resp = await fetch(url);
                const blob = await resp.blob();
                const file = new File([blob], filename, { type: blob.type || 'image/jpeg' });
                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                    await navigator.share({ files: [file], title: filename });
                    return;
                }
            } catch (err) {
                if (err.name !== 'AbortError') console.warn('share failed, falling back to link', err);
            }
        }

        // Fallback: traditional download
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    async function downloadSelected() {
        const photos = allPhotos.filter(p => selectedFiles.has(p.filename));
        if (photos.length === 0) return;

        if (isIOS() && navigator.share) {
            // Try to batch all files into a single share sheet
            try {
                const files = await Promise.all(photos.map(async p => {
                    const resp = await fetch(fullPhotoUrl(p.filename, p.rotation || 0));
                    const blob = await resp.blob();
                    return new File([blob], p.filename, { type: blob.type || 'image/jpeg' });
                }));
                if (navigator.canShare && navigator.canShare({ files })) {
                    await navigator.share({ files });
                    return;
                }
            } catch (err) {
                if (err.name === 'AbortError') return;
                console.warn('Batch share failed, falling back to sequential', err);
            }
            // Fallback: sequential share
            for (let i = 0; i < photos.length; i++) {
                try {
                    await downloadFile(photos[i].filename, photos[i].rotation || 0);
                    if (i < photos.length - 1) await new Promise(r => setTimeout(r, 300));
                } catch (err) {
                    console.warn('Failed to share', photos[i].filename, err);
                }
            }
        } else {
            // Desktop: trigger downloads with stagger
            photos.forEach((p, i) => {
                setTimeout(() => downloadFile(p.filename, p.rotation || 0), i * 400);
            });
        }
    }

    // ── Card builder ─────────────────────────────────────

    function buildCard(photo, index) {
        const card = document.createElement('div');
        card.className = 'photo-card';
        if (photo.hidden) card.classList.add('is-hidden');
        card.dataset.index = index;
