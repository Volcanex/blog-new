@bp.route('/rotate', methods=['POST'])
def rotate_photo():
    """
    Admin: rotate a photo 90° at a time.
    Body: { filename, direction: "cw"|"ccw" }
    Rotation stored as degrees CCW. Cached thumbnails are deleted on change.
    """
    require_admin()
    data = request.get_json(silent=True) or {}
    filename = Path(data.get('filename', '')).name
    direction = data.get('direction', 'cw')

    if not filename:
        return jsonify({'error': 'filename required'}), 400
    if direction not in ('cw', 'ccw'):
        return jsonify({'error': 'direction must be cw or ccw'}), 400

    rotations = get_rotations()
    current = rotations.get(filename, 0)
    new_rotation = (current - 90) % 360 if direction == 'cw' else (current + 90) % 360

    if new_rotation == 0:
        rotations.pop(filename, None)
    else:
        rotations[filename] = new_rotation
    save_rotations(rotations)

    # Bust disk cache for all sizes
    for cached in THUMB_DIR.glob(f"{filename}_*.jpg"):
        cached.unlink(missing_ok=True)

    return jsonify({'ok': True, 'rotation': new_rotation})


@bp.route('/update-metadata', methods=['POST'])
def update_metadata():
    """
    Admin: set description, location, and/or country for a photo.
    Body: { filename, description?, location?, country? }
    Omitted fields are left unchanged.
    """
    require_admin()
    data = request.get_json(silent=True) or {}
    filename = Path(data.get('filename', '')).name
    if not filename:
        return jsonify({'error': 'filename required'}), 400

    metadata = get_metadata()
    entry = metadata.get(filename, {})

    for field in ('description', 'location', 'city', 'country'):
        if field in data:
            value = str(data[field]).strip()
            if value:
                entry[field] = value
            else:
                entry.pop(field, None)  # remove if blank

    if entry:
        metadata[filename] = entry
    else:
        metadata.pop(filename, None)

    save_metadata(metadata)
    return jsonify({'ok': True, 'metadata': entry})



# Background pre-warm progress, shared across requests. The worker thread is
# daemonised so a server restart kills it cleanly. A short sleep between
# masters keeps the rclone mount + Flask worker responsive to user requests.
_PREWARM_LOCK = __import__('threading').Lock()
_PREWARM_STATE = {'running': False, 'generated': 0, 'skipped': 0,
                  'failed': 0, 'total': 0, 'target_size': 0,
                  'started_at': 0.0, 'finished_at': 0.0}


def _prewarm_worker(target_size):
    import time
    state = _PREWARM_STATE
    try:
        manifest_masters = _load_manifest().get('masters', {})
        rotations = get_rotations()
        hidden = get_hidden()
        state['total'] = len(manifest_masters)

        for filename in manifest_masters:
            if filename.startswith('.') or filename in hidden:
                state['skipped'] += 1
                continue
            rotation = rotations.get(filename, 0)
            cache_path = THUMB_DIR / f"{filename}_{target_size}_r{rotation}.jpg"
            if cache_path.exists():
                state['skipped'] += 1
                continue
            source = MASTERS_DIR / filename
            if not source.exists():
                state['skipped'] += 1
                continue
            try:
                _ensure_thumb('', filename, target_size, rotation,
                              lambda src=source: Image.open(src))
                state['generated'] += 1
            except Exception:
                state['failed'] += 1
            # Yield briefly so concurrent /photos and /thumbnail requests
            # from real users can interleave on the single-thread worker.
            time.sleep(0.05)
    finally:
        state['finished_at'] = time.time()
        state['running'] = False


@bp.route('/pre-warm', methods=['POST'])
def pre_warm():
    """Admin: kick off a background pre-warm of the thumbnail cache.

    Returns immediately. Worker thread iterates the manifest and triggers
    _ensure_thumb at size=target_size (default 800). The helper writes 32
    and 200 from the same in-memory image, so one R2 read covers LQIP +
    list + full thumb for that photo.

        curl -X POST -H "X-Admin-Password: $TOKEN" \
            http://127.0.0.1:5000/api/photography/pre-warm

    GET returns current progress (no auth needed for status — it leaks no
    sensitive info, just counts):

        curl http://127.0.0.1:5000/api/photography/pre-warm
    """
    require_admin()
    try:
        target_size = int(request.args.get('size', 800))
        target_size = max(32, min(target_size, 1600))
    except (ValueError, TypeError):
        target_size = 800

    import time
    import threading
    with _PREWARM_LOCK:
        if _PREWARM_STATE['running']:
            return jsonify({'ok': False, 'error': 'pre-warm already running',
                            'state': _PREWARM_STATE})
        _PREWARM_STATE.update({
            'running': True, 'generated': 0, 'skipped': 0, 'failed': 0,
            'total': 0, 'target_size': target_size,
            'started_at': time.time(), 'finished_at': 0.0,
        })
        threading.Thread(target=_prewarm_worker, args=(target_size,),
                         daemon=True).start()
    return jsonify({'ok': True, 'started': True, 'state': _PREWARM_STATE})


@bp.route('/pre-warm', methods=['GET'])
def pre_warm_status():
    return jsonify({'ok': True, 'state': _PREWARM_STATE})


@bp.route('/full/<path:filename>')
def full_photo(filename):
    """
    Serve a web-optimised full-resolution JPEG (quality=85, progressive).
    Re-encodes the master on first request and caches to disk; subsequent
    requests are served straight from the cache.
    Cache key: {filename}_webfull.jpg or {filename}_webfull_r{rotation}.jpg
    (same glob pattern as thumbnails, so rotation changes bust this cache too).
    """
    filename = Path(filename).name
    source = MASTERS_DIR / filename

    if not source.exists():
        abort(404)

    hidden = get_hidden()
    if filename in hidden and not is_admin():
        abort(404)

    try:
        r_param = request.args.get('r')
        if r_param is not None:
            rotation = int(r_param)
            rotation = rotation if rotation in (0, 90, 180, 270) else 0
        else:
            rotation = get_rotations().get(filename, 0)
    except (ValueError, TypeError):
        rotation = 0

    suffix = f'_webfull_r{rotation}.jpg' if rotation else '_webfull.jpg'
    cache_path = THUMB_DIR / f'{filename}{suffix}'

    if not cache_path.exists():
        try:
            img = Image.open(source)
            if img.mode != 'RGB':
                img = img.convert('RGB')
            if rotation:
                img = img.rotate(rotation, expand=True)
            img.save(cache_path, 'JPEG', quality=WEBFULL_QUALITY,
                     optimize=True, progressive=True)
        except Exception:
            abort(500)

    response = send_file(cache_path, mimetype='image/jpeg')
    response.headers['Cache-Control'] = 'public, max-age=86400'
    return response


@bp.route('/thumbnail/<path:filename>')
def thumbnail(filename):
    """
    Serve a resized JPEG thumbnail, cached to disk.
    ?size=<int>   max dimension (default 800, max 1600)
    ?r=<int>      rotation degrees CCW (0/90/180/270); reads from DB if omitted
    Cache key: {filename}_{size}_r{rotation}.jpg
    """
    filename = Path(filename).name
    source = MASTERS_DIR / filename

    if not source.exists():
        abort(404)

    hidden = get_hidden()
    if filename in hidden and not is_admin():
        abort(404)

    try:
        size = int(request.args.get('size', 800))
        size = max(24, min(size, 1600))
    except (ValueError, TypeError):
        size = 800

    try:
        r_param = request.args.get('r')
        if r_param is not None:
            rotation = int(r_param)
            rotation = rotation if rotation in (0, 90, 180, 270) else 0
        else:
            rotation = get_rotations().get(filename, 0)
    except (ValueError, TypeError):
        rotation = 0

    try:
        cache_path = _ensure_thumb('', filename, size, rotation,
                                   lambda: Image.open(source))
    except Exception:
        abort(500)

    response = send_file(cache_path, mimetype='image/jpeg')
    response.headers['Cache-Control'] = 'public, max-age=86400'
    return response




