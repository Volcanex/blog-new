@bp.route('/photos')
def list_photos():
    """
    Return photos with EXIF + metadata, sorted newest-first.
    Public: non-hidden only. Admin: all, with hidden:bool.
    Both get rotation, description, location, country.
    """
    admin = is_admin()
    hidden = get_hidden()
    rotations = get_rotations()
    metadata = get_metadata()
    background_photos = get_background_photos()
    photos = []

    manifest_masters = _load_manifest().get('masters', {})
    for filename, entry in manifest_masters.items():
        if filename.startswith('.'):
            continue
        if entry.get('size_bytes', 0) < MIN_PHOTO_BYTES:
            continue

        is_hidden = filename in hidden
        if is_hidden and not admin:
            continue

        meta = metadata.get(filename, {})
        is_background = filename in background_photos

        exif = {k: v for k, v in entry.items()
                if k not in ('size_bytes', 'mtime', '_exif_error')}

        photo = {
            'filename': filename,
            'size_mb': round(entry.get('size_bytes', 0) / (1024 ** 2), 1),
            'rotation': rotations.get(filename, 0),
            'description': meta.get('description', ''),
            'location': meta.get('location', ''),
            'city': meta.get('city', ''),
            'country': meta.get('country', ''),
            'isBackground': is_background,  # public: doubles as "highlight" flag for the gallery sidebar
            **exif,
        }
        if admin:
            photo['hidden'] = is_hidden

        photos.append(photo)

    photos.sort(
        key=lambda p: p.get('datetime_sort') or p['filename'],
        reverse=True
    )
    for p in photos:
        p.pop('datetime_sort', None)

    # ── Country + city interpolation ──────────────────────
    # Photos are sorted newest-first.  Walk forward carrying the most recent
    # explicitly-set value so that gaps are filled with "assumed" values.
    # A photo with its own explicit value is never marked assumed.
    current_country = ''
    current_city = ''
    for p in photos:
        if p.get('country'):
            current_country = p['country']
            p['country_assumed'] = False
        elif current_country:
            p['country'] = current_country
            p['country_assumed'] = True
        else:
            p['country_assumed'] = False

        if p.get('city'):
            current_city = p['city']
            p['city_assumed'] = False
        elif current_city:
            p['city'] = current_city
            p['city_assumed'] = True
        else:
            p['city_assumed'] = False

    return jsonify({'photos': photos, 'count': len(photos)})


